{
  "name": "interview-xwzy-dev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "gen:meta": "node scripts/gen-track-meta.mjs",
    "build": "npm run gen:meta && tsc -b && vite build && node scripts/inject-sw-version.mjs && node scripts/check-dist.mjs",
