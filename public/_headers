# 全站响应头（Cloudflare Pages 原生支持）
# CSP 的 script-src 哈希对应 index.html 内联主题脚本，改脚本后需同步——
# scripts/check-dist.mjs 会校验哈希一致性，失配时构建失败并提示
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-MPLoEUwhhkBM3c+0sdBvsbmhhp0yE9cCl/DXCkjPC3M='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
